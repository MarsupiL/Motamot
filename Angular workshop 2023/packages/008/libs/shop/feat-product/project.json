{
  "name": "shop-feat-product",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/shop/feat-product/src",
  "prefix": "sh",
  "targets": {
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shop/feat-product/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/shop/feat-product/**/*.ts",
          "libs/shop/feat-product/**/*.html"
        ]
      }
    },
    "mock-api": {
      "executor": "@shoppie/tools:mock-api"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/shop/feat-product/.storybook",
        "browserTarget": "shop-feat-product:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/shop-feat-product",
        "configDir": "libs/shop/feat-product/.storybook",
        "browserTarget": "shop-feat-product:build-storybook",
        "compodoc": false,
        "styles": ["apps/shop/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/frontend/ui-design-system/src/lib/styles"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  },
  "tags": ["scope:shop", "type:feat"]
}
