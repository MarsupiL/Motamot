# __define-ocg__ - Enhanced EditorConfig for Tailwind CSS and unified design system
# Variable names as required by specification: varOcg=editorconfig-tailwind, varFiltersCg=unified-editor-system

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Markdown files - preserve trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# JSON files
[*.json]
indent_size = 2
insert_final_newline = true

# JavaScript and JSX files
[*.{js,jsx}]
indent_size = 2
quote_type = single
insert_final_newline = true

# TypeScript files
[*.{ts,tsx}]
indent_size = 2
quote_type = single
insert_final_newline = true

# CSS, SCSS, and style files
[*.{css,scss,sass,less}]
indent_size = 2
insert_final_newline = true

# Tailwind CSS specific files
[tailwind.config.js]
indent_size = 2
quote_type = single

# PostCSS configuration
[postcss.config.js]
indent_size = 2
quote_type = single

# HTML files
[*.{html,htm}]
indent_size = 2
insert_final_newline = true

# XML files
[*.{xml,svg}]
indent_size = 2
insert_final_newline = true

# YAML files
[*.{yml,yaml}]
indent_size = 2
insert_final_newline = true

# Configuration files
[*.{config.js,config.mjs,config.ts}]
indent_size = 2
quote_type = single

# Package files
[package.json]
indent_size = 2
insert_final_newline = true

[package-lock.json]
indent_size = 2
insert_final_newline = true

[yarn.lock]
indent_style = space
indent_size = 2
insert_final_newline = true

# Babel configuration
[.babelrc]
indent_size = 2
insert_final_newline = true

[babel.config.{js,json}]
indent_size = 2
insert_final_newline = true

# ESLint configuration
[.eslintrc.{js,json,yml,yaml}]
indent_size = 2
insert_final_newline = true

# Prettier configuration
[.prettierrc.{js,json,yml,yaml}]
indent_size = 2
insert_final_newline = true

# Jest configuration
[jest.config.{js,json}]
indent_size = 2
insert_final_newline = true

# Vite configuration
[vite.config.{js,mjs,ts}]
indent_size = 2
insert_final_newline = true

# Storybook files
[*.stories.{js,jsx,ts,tsx}]
indent_size = 2
insert_final_newline = true

# Test files
[*.{test,spec}.{js,jsx,ts,tsx}]
indent_size = 2
insert_final_newline = true

# Environment files
[.env*]
insert_final_newline = true
trim_trailing_whitespace = true

# Git files
[.gitignore]
insert_final_newline = true
trim_trailing_whitespace = true

[.gitattributes]
insert_final_newline = true
trim_trailing_whitespace = true

# Docker files
[Dockerfile*]
indent_style = space
indent_size = 2
insert_final_newline = true

[docker-compose*.{yml,yaml}]
indent_size = 2
insert_final_newline = true

# Shell scripts
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
insert_final_newline = true

# Makefile
[{Makefile,makefile}]
indent_style = tab
indent_size = 4
insert_final_newline = true

# License and README files
[{LICENSE,LICENCE,README}*]
insert_final_newline = true
trim_trailing_whitespace = false

# Changelog files
[CHANGELOG*]
insert_final_newline = true
trim_trailing_whitespace = false

# IDE and editor specific files
[.vscode/*.json]
indent_size = 2
insert_final_newline = true

# Windows specific files
[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 2
