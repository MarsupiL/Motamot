{
  "name": "lumen-design-system",
  "version": "1.0.0",
  "description": "Lumen Design System - A modern, accessible, and beautiful design system built with React and Tailwind CSS",
  "main": "src/main.jsx",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/ --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,scss,md}\"",
    "tailwind:build": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/tailwind.css --watch",
    "tailwind:minify": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/tailwind.min.css --minify",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "node scripts/deploy.js",
    "clean": "rm -rf dist build coverage",
    "analyze": "vite-bundle-analyzer dist",
    "serve": "node index.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-redux": "^9.0.0",
    "redux": "^5.0.0",
    "redux-thunk": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/runtime": "^7.23.0",
    "@storybook/addon-essentials": "^7.5.0",
    "@storybook/react": "^7.5.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.1.0",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.7.0",
    "cssnano": "^6.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "sass": "^1.69.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "resolutions": {
    "ajv": "^8.12.0"
  },
  "overrides": {
    "ajv": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "components",
    "ui",
    "accessibility",
    "lumen",
    "frontend",
    "javascript",
    "css"
  ],
  "author": "Lumen Design Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumen-design/lumen-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/lumen-design/lumen-design-system/issues"
  },
  "homepage": "https://lumen-design-system.com",
  "files": [
    "dist",
    "src",
    "tailwind.config.js",
    "postcss.config.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/tailwind.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "config": {
    "tailwind": {
      "varOcg": "package-tailwind-config",
      "varFiltersCg": "unified-package-system"
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapping": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindConfig": "./tailwind.config.js"
  },
  "eslintConfig": {
    "extends": [
      "./.estlintrc.js"
    ]
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/lumen-design-system"
  },
  "volta": {
    "node": "18.18.0",
    "npm": "9.8.1"
  }
}
